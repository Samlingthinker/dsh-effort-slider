{
  "name": "dsh-effort-slider",
  "version": "1.0.1",
  "description": "把 DSH 官方模型菜单里的「推理等级 / Effort」下拉替换为 Codex 风格连续滑块 + 流光粒子动效（WebGL2），并提供设置页独立分区（浅色 / 深色 / 跟随系统外观）。零依赖宿主半边，克隆后 dsh plugin add 即可用。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "effort",
    "reasoning",
    "slider",
    "webgl"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Samlingthinker/dsh-effort-slider.git"
  },
  "homepage": "https://github.com/Samlingthinker/dsh-effort-slider#readme",
  "bugs": {
    "url": "https://github.com/Samlingthinker/dsh-effort-slider/issues"
  },
  "license": "BSD-3-Clause"
}
